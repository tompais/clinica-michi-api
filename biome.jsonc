{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  // Respeta el .gitignore: no revisa node_modules ni coverage.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!bun.lock"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded", "trailingCommas": "all" },
    // Nest usa decoradores en los parámetros: @Body(), @Param(), @Inject().
    "parser": { "unsafeParameterDecoratorsEnabled": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // Apagada a propósito: Nest inyecta por el tipo del constructor y valida por la clase del DTO.
        // Si esos imports pasan a "import type", desaparecen al compilar y la inyección se rompe.
        "useImportType": "off"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
