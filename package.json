{
  "name": "clinica-michi-api",
  "version": "0.0.0",
  "private": true,
  "description": "API de la Clínica Veterinaria Michi: el código de ejemplo del Michi Dev Quest",
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "job:recordatorios": "ROL=job-recordatorios bun src/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migration:run": "bun ./node_modules/typeorm/cli.js migration:run -d src/shared/infraestructura/database/data-source.ts",
    "migration:revert": "bun ./node_modules/typeorm/cli.js migration:revert -d src/shared/infraestructura/database/data-source.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@google-cloud/pubsub": "5.3.1",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/typeorm": "11.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "typeorm-pglite": "0.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "3.2.7",
    "husky": "9.1.7",
    "knip": "6.44.0",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
