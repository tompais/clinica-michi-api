# Copiá este archivo como .env y completalo
PORT=3000
# Sin DATABASE_URL la API usa un Postgres en memoria y carga datos de ejemplo.
# Para usar el Postgres de docker compose, descomentá la línea de abajo.
# DATABASE_URL=postgres://clinica:clinica@localhost:5432/clinica
# api para levantar la API. job-recordatorios para correr el job y terminar.
ROL=api
# false manda los eventos a la consola. true los publica en Pub/Sub de Google.
PUBSUB_HABILITADO=false
